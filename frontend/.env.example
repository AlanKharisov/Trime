# Public values only — everything here is embedded into the static site.

# Order API endpoint (telegram-api). Production: https://trime-telegram-api.vercel.app/api/order
NEXT_PUBLIC_ORDER_ENDPOINT=http://localhost:8787/api/order

# Canonical site URL used for metadata.
NEXT_PUBLIC_SITE_URL=https://trime.org

# Show unverified placeholder content (portfolio demos, email, social links) in a
# production build, e.g. for a review deployment. Always on in `next dev`.
# NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
